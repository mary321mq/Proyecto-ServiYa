# .env Production profile for docker-compose
SPRING_PROFILES_ACTIVE=prod
CONFIG_SERVER_URL=http://config-server:7071

# MySQL container/app credentials
NOTIFICATION_MYSQL_ROOT_PASSWORD=root
NOTIFICATION_MYSQL_DATABASE=db_notification

# Spring datasource (used by ms-notification)
NOTIFICATION_DB_HOST=mysql-notification
NOTIFICATION_DB_PORT=3306
NOTIFICATION_DB_NAME=db_notification
NOTIFICATION_DB_USERNAME=root
NOTIFICATION_DB_PASSWORD=root
