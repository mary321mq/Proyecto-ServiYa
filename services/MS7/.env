# .env Production profile for docker-compose
SPRING_PROFILES_ACTIVE=prod
CONFIG_SERVER_URL=http://config-server:7071

# MySQL container/app credentials
REVIEW_MYSQL_ROOT_PASSWORD=root
REVIEW_MYSQL_DATABASE=db_review

# Spring datasource (used by ms-review)
REVIEW_DB_HOST=mysql-review
REVIEW_DB_PORT=3306
REVIEW_DB_NAME=db_review
REVIEW_DB_USERNAME=root
REVIEW_DB_PASSWORD=root
